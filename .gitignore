# ------------------------------------------------------------

__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
**/*.egg-info/

# Pytest
.pytest_cache/

