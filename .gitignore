# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
*~
.directory


# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.local


# ------------------------------------------------------------
# Rust / Cargo
# ------------------------------------------------------------

# Cargo build output
target/
**/target/

# Rustfmt backup files
**/*.rs.bk

# Rust compiler debug information
*.pdb

# Cargo mutants
**/mutants.out/

# Rust coverage / profiling
*.profraw
*.profdata
coverage/


